# Jihoz.uz — muhit o'zgaruvchilari
# .env faylini nusxalang va to'ldiring: cp .env.example .env
# .env hech qachon gitga qo'shilmaydi (.gitignore'da)

# ─── Frontend (ochiq, xavfsiz — anon kaliti faqat o'qish uchun) ───
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ─── Server (maxfiy — hech qachon frontend'ga tushmasin) ───
# TanStack Start server route'lar uchun
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ─── Telegram bot (FAQAT serverda, hech qachon kodga yozilmaydi) ───
# Bot: @Jihoz_uz_bot
TELEGRAM_BOT_TOKEN=<botfather-token>
TELEGRAM_BOT_USERNAME=Jihoz_uz_bot
# Telegram webhook secret_token — @BotFather / setWebhook da bir xil bo'lishi shart
TELEGRAM_WEBHOOK_SECRET=<random-64-hex-chars>
# Chat xabarlari uchun bildirishnoma (hozir O'CHIRILGAN — docs/security.md §11)
# Database Webhook orqali chaqiriladi, x-notify-secret sarlavhasi bilan
TELEGRAM_NOTIFY_SECRET=<random-64-hex-chars>

# ─── Funksiya flaglari ───
# true bo'lsa: Telegram tasdiqlash e'lon qo'shish uchun majburiy bo'ladi
TELEGRAM_VERIFICATION_REQUIRED=false
